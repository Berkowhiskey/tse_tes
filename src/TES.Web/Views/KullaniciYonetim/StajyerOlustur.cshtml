@model StajyerOlusturViewModel
@{
    ViewData["Title"] = "Yeni Stajyer";
}

<div class="page-header d-print-none mb-3">
    <h2 class="page-title">Yeni Stajyer Oluştur</h2>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger col-lg-8" role="alert"></div>
}

@* ===================== Toplu Ekleme (Excel) ===================== *@
<div class="card col-lg-8 mb-3">
    <div class="card-header">
        <h3 class="card-title">Toplu Ekleme (Excel)</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary">
            İnsan Kaynakları için: boş şablonu indirin, doldurup geri alın, sonra yükleyin. Geçerli satırlar eklenir,
            hatalı satırlar aşağıda satır numarasıyla listelenir. T.C. Kimlik No yalnızca ilk geçici paroladır —
            <strong>sistemde saklanmaz</strong>. Amir bu aşamada atanmaz; sonradan “Eşleştir” ekranından atanır.
        </p>

        <div class="d-flex flex-wrap gap-2 align-items-end">
            <a asp-action="SablonIndir" class="btn btn-outline-primary">Şablon İndir (.xlsx)</a>

            <form asp-action="TopluEkle" method="post" enctype="multipart/form-data"
                  class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    <label class="form-label mb-1">Doldurulmuş dosya</label>
                    <input type="file" name="dosya" accept=".xlsx" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Toplu Ekle</button>
            </form>
        </div>

        @if (Model.TopluSonuc is { } sonuc)
        {
            <div class="mt-3">
                <div class="alert @(sonuc.EklenenSayisi > 0 ? "alert-success" : "alert-warning") mb-2" role="alert">
                    <strong>@sonuc.EklenenSayisi</strong> stajyer eklendi, <strong>@sonuc.AtlananSayisi</strong> satır atlandı.
                    @if (sonuc.EklenenSayisi > 0)
                    {
                        <text> Eklenenler için ilk parola T.C. Kimlik No'dur; ilk girişte değişim zorunludur.</text>
                    }
                </div>

                @if (sonuc.Hatalar.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-vcenter">
                            <thead>
                                <tr>
                                    <th style="width: 6rem;">Satır</th>
                                    <th>Neden</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hata in sonuc.Hatalar)
                                {
                                    <tr>
                                        <td>@(hata.SatirNo == 0 ? "—" : hata.SatirNo.ToString())</td>
                                        <td>@hata.Neden</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (sonuc.EklenenKullaniciAdlari.Any())
                {
                    <details class="mt-2">
                        <summary>Eklenen kullanıcı adları (@sonuc.EklenenKullaniciAdlari.Count)</summary>
                        <div class="mt-2 small text-secondary">@string.Join(", ", sonuc.EklenenKullaniciAdlari)</div>
                    </details>
                }
            </div>
        }
    </div>
</div>

@* ===================== Tek Tek Ekle ===================== *@
<div class="card col-lg-8">
    <div class="card-header">
        <h3 class="card-title">Tek Tek Ekle</h3>
    </div>
    <div class="card-body">
        <form asp-action="StajyerOlustur" method="post" autocomplete="off" novalidate>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Ad" class="form-label"></label>
                    <input asp-for="Ad" class="form-control" autofocus />
                    <span asp-validation-for="Ad" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Soyad" class="form-label"></label>
                    <input asp-for="Soyad" class="form-control" />
                    <span asp-validation-for="Soyad" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TcKimlikNo" class="form-label"></label>
                    <input asp-for="TcKimlikNo" class="form-control" maxlength="11" />
                    <span asp-validation-for="TcKimlikNo" class="text-danger small"></span>
                    <small class="form-hint">Yalnızca geçici parola olur; saklanmaz.</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="KartNo" class="form-label"></label>
                    <input asp-for="KartNo" class="form-control" />
                    <span asp-validation-for="KartNo" class="text-danger small"></span>
                    <small class="form-hint">Kullanıcı adına eklenir: ad_soyad_kartno</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StajBaslangic" class="form-label"></label>
                    <input asp-for="StajBaslangic" class="form-control" type="date" />
                    <span asp-validation-for="StajBaslangic" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="StajBitis" class="form-label"></label>
                    <input asp-for="StajBitis" class="form-control" type="date" />
                    <span asp-validation-for="StajBitis" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Okul" class="form-label"></label>
                    <input asp-for="Okul" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Bolum" class="form-label"></label>
                    <input asp-for="Bolum" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="AmirProfilId" class="form-label"></label>
                <select asp-for="AmirProfilId" asp-items="Model.AmirSecenekleri" class="form-select">
                    <option value="">(Sonra eşleştirilecek)</option>
                </select>
            </div>

            <div class="form-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">Oluştur</button>
                <a asp-action="Index" class="btn">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
