@model SohbetPencereViewModel
@{
    ViewData["Title"] = $"Sohbet — {Model.KarsiAdSoyad}";
    var sonBenim = Model.Mesajlar.LastOrDefault(m => m.GondericiId == Model.BenId);
    var baslangicOkundu = sonBenim?.OkunduMu == true;
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">İletişim</div>
            <h2 class="page-title">@Model.KarsiAdSoyad</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn">← Konuşmalar</a>
        </div>
    </div>
</div>

<div class="card col-lg-8 mx-auto">
    <div class="card-body">
        <div id="mesajListesi" style="height: 420px; overflow-y: auto;" class="d-flex flex-column gap-2 mb-1">
            @foreach (var mesaj in Model.Mesajlar)
            {
                var benim = mesaj.GondericiId == Model.BenId;
                <div class="d-flex @(benim ? "justify-content-end" : "justify-content-start")">
                    <div class="px-3 py-2 rounded @(benim ? "bg-primary text-white" : "bg-secondary-lt")" style="max-width: 75%;">
                        <div style="white-space: pre-wrap; word-break: break-word;">@mesaj.Icerik</div>
                        <div class="small @(benim ? "text-white-50" : "text-secondary")" style="text-align: right;">
                            @mesaj.Zaman.ToLocalTime().ToString("dd.MM HH:mm")
                        </div>
                    </div>
                </div>
            }
        </div>

        @* "Yazıyor..." ve "Okundu" göstergeleri *@
        <div class="d-flex justify-content-between align-items-center mb-2" style="min-height: 1.25rem">
            <span id="yaziyorGosterge" class="small text-secondary fst-italic"></span>
            <span id="okunduGosterge" class="small text-secondary">@(baslangicOkundu ? "Okundu ✓✓" : "")</span>
        </div>

        @if (Model.SaltOkunur)
        {
            <div class="alert alert-secondary mb-0 text-center">İzleme modu — mesaj gönderemezsiniz.</div>
        }
        else
        {
            <form id="mesajFormu" class="d-flex gap-2">
                <input type="text" id="mesajKutusu" class="form-control" placeholder="Mesaj yazın..." maxlength="2000" autocomplete="off" autofocus />
                <button type="submit" id="gonderBtn" class="btn btn-primary">Gönder</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const benId = @Html.Raw(Json.Serialize(Model.BenId));
            const karsiId = @Html.Raw(Json.Serialize(Model.KarsiId));
            const karsiAd = @Html.Raw(Json.Serialize(Model.KarsiAdSoyad));
            const saltOkunur = @(Model.SaltOkunur ? "true" : "false");

            const liste = document.getElementById("mesajListesi");
            const yaziyorEl = document.getElementById("yaziyorGosterge");
            const okunduEl = document.getElementById("okunduGosterge");
            const hub = window.tesHub;

            // Bu konuşma açık: global bildirim (toast) bu kişiden gelen mesajlar için susar.
            window.tesAktifKonusma = karsiId;

            let benimSonMesajVar = @( (sonBenim is not null).ToString().ToLowerInvariant() );
            let yaziyorTimer = null, sonYaziyorGonderim = 0;

            function altaKaydir() { liste.scrollTop = liste.scrollHeight; }
            altaKaydir();

            function okunduGoster(goster) {
                okunduEl.textContent = goster ? "Okundu ✓✓" : "";
            }
            function yaziyorGizle() { yaziyorEl.textContent = ""; }

            // Mesaj balonunu güvenli biçimde ekler (XSS: textContent, innerHTML DEĞİL).
            function mesajEkle(icerik, zamanIso, benim) {
                const satir = document.createElement("div");
                satir.className = "d-flex " + (benim ? "justify-content-end" : "justify-content-start");
                const balon = document.createElement("div");
                balon.className = "px-3 py-2 rounded " + (benim ? "bg-primary text-white" : "bg-secondary-lt");
                balon.style.maxWidth = "75%";
                const metin = document.createElement("div");
                metin.style.whiteSpace = "pre-wrap";
                metin.style.wordBreak = "break-word";
                metin.textContent = icerik;
                const zaman = document.createElement("div");
                zaman.className = "small " + (benim ? "text-white-50" : "text-secondary");
                zaman.style.textAlign = "right";
                zaman.textContent = new Date(zamanIso).toLocaleString("tr-TR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" });
                balon.appendChild(metin);
                balon.appendChild(zaman);
                satir.appendChild(balon);
                liste.appendChild(satir);
                altaKaydir();
            }

            if (hub) {
                hub.on("MesajAlindi", function (m) {
                    const buKonusma = (m.gondericiId === benId && m.aliciId === karsiId) ||
                                      (m.gondericiId === karsiId && m.aliciId === benId);
                    if (!buKonusma) return;

                    const benim = m.gondericiId === benId;
                    mesajEkle(m.icerik, m.zaman, benim);

                    if (benim) {
                        benimSonMesajVar = true;
                        okunduGoster(false); // yeni mesaj gönderdim; karşı okuyunca güncellenir
                    } else {
                        // Karşıdan geldi ve ben bu konuşmadayım → okundu bildir + yazıyor'u temizle
                        yaziyorGizle();
                        if (window.tesHubReady) window.tesHubReady.then(function () { hub.invoke("OkunduBildir", karsiId).catch(function(){}); });
                    }
                });

                hub.on("Yaziyor", function (fromId) {
                    if (fromId !== karsiId) return;
                    yaziyorEl.textContent = karsiAd + " yazıyor...";
                    clearTimeout(yaziyorTimer);
                    yaziyorTimer = setTimeout(yaziyorGizle, 3000);
                });

                hub.on("Okundu", function (fromId) {
                    if (fromId !== karsiId) return;
                    if (benimSonMesajVar) okunduGoster(true);
                });

                // Sayfa açılışında: karşının bana gönderdiklerini okundu işaretle (ve karşıya bildir).
                if (!saltOkunur && window.tesHubReady) {
                    window.tesHubReady.then(function () { hub.invoke("OkunduBildir", karsiId).catch(function(){}); });
                }

                // Admin izleme: konuşma grubuna katılarak mesajları CANLI al. Reconnect'te tekrar katıl.
                if (saltOkunur) {
                    function izlemeyeKatil() { hub.invoke("IzlemeyeBasla", benId, karsiId).catch(function(){}); }
                    if (window.tesHubReady) window.tesHubReady.then(izlemeyeKatil);
                    hub.onreconnected(izlemeyeKatil);
                }
            }

            if (!saltOkunur && hub) {
                const form = document.getElementById("mesajFormu");
                const kutu = document.getElementById("mesajKutusu");
                const btn = document.getElementById("gonderBtn");

                // Yazarken karşıya "yazıyor" sinyali (throttle ~1.5sn).
                kutu.addEventListener("input", function () {
                    const now = Date.now();
                    if (now - sonYaziyorGonderim > 1500) {
                        sonYaziyorGonderim = now;
                        if (window.tesHubReady) window.tesHubReady.then(function () { hub.invoke("Yaziyor", karsiId).catch(function(){}); });
                    }
                });

                form.addEventListener("submit", async function (e) {
                    e.preventDefault();
                    const icerik = kutu.value.trim();
                    if (!icerik) return;
                    btn.disabled = true;
                    try {
                        if (window.tesHubReady) await window.tesHubReady;
                        await hub.invoke("GonderMesaj", karsiId, icerik);
                        kutu.value = "";
                    } catch (err) {
                        console.error(err && err.toString());
                        alert("Mesaj gönderilemedi: " + (err && (err.message || err)));
                    } finally {
                        btn.disabled = false;
                        kutu.focus();
                    }
                });
            }
        })();
    </script>
}
