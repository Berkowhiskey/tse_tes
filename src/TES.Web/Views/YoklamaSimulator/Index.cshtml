@model SimulatorViewModel
@{
    ViewData["Title"] = "RFID Simülatörü";
}

<div class="page-header d-print-none mb-3">
    <div class="page-pretitle">Simülasyon</div>
    <h2 class="page-title">RFID Yoklama Simülatörü</h2>
</div>

<div class="alert alert-info col-lg-6" role="alert">
    Bu ekran, kurum girişindeki fiziksel RFID gişelerinin <strong>simülasyonudur</strong>.
    Kart okutulduğunda: aynı gün açık oturum varsa <strong>çıkış</strong>, yoksa <strong>giriş</strong> yazılır.
</div>

@if (Model.SonucMesaji is not null)
{
    <div class="alert @(Model.SonucBasarili == true ? "alert-success" : "alert-danger") col-lg-6" role="alert">
        @Model.SonucMesaji
    </div>
}

<div class="card col-lg-6">
    <div class="card-body">
        <form asp-action="KartOkut" method="post" novalidate>
            <div class="mb-3">
                <label class="form-label">Kart Seç</label>
                <select name="kartNo" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (var kart in Model.KartSecenekleri)
                    {
                        <option value="@kart.Value">@kart.Text</option>
                    }
                </select>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">📡 Kartı Okut</button>
            </div>
        </form>
    </div>
</div>
