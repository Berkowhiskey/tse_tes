@using TES.Domain.Sabitler
@{
    ViewData["Title"] = "Ana Sayfa";

    var adminMi = User.IsInRole(Roller.Admin);
    var amirMi = User.IsInRole(Roller.Amir);
    var stajyerMi = User.IsInRole(Roller.Stajyer);
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">TSE — Takip ve Eğitim Sistemi</div>
            <h2 class="page-title">Hoş geldiniz</h2>
        </div>
    </div>
</div>

<div class="row row-cards">
    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Gonderi" asp-action="Index" class="card card-link">
            <div class="card-body">
                <h3 class="card-title">💬 Sosyal Akış</h3>
                <p class="text-secondary">Gönderi paylaşın, yorum yapın, beğenin.</p>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Sohbet" asp-action="Index" class="card card-link">
            <div class="card-body">
                <h3 class="card-title">💌 Sohbet</h3>
                <p class="text-secondary">
                    @(adminMi ? "Amir–stajyer konuşmalarını izleyin."
                        : amirMi ? "Stajyerlerinizle mesajlaşın."
                        : "Amirinizle mesajlaşın.")
                </p>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Yoklama" asp-action="Index" class="card card-link">
            <div class="card-body">
                <h3 class="card-title">🕐 Yoklama</h3>
                <p class="text-secondary">
                    @(adminMi ? "Tüm stajyerlerin giriş-çıkış kayıtları."
                        : amirMi ? "Stajyerlerinizin giriş-çıkış kayıtları."
                        : "Giriş-çıkış kayıtlarınız.")
                </p>
            </div>
        </a>
    </div>

    @if (adminMi || stajyerMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="YoklamaSimulator" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">📡 RFID Simülatör</h3>
                    <p class="text-secondary">
                        @(adminMi ? "Kart okutma simülasyonu (tüm kartlar)." : "Kartınızı okutun: giriş / çıkış.")
                    </p>
                </div>
            </a>
        </div>
    }

    @if (adminMi || amirMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Stajyerler" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">👥 Stajyerler</h3>
                    <p class="text-secondary">@(adminMi ? "Tüm stajyerler ve detayları." : "Size eşleştirilmiş stajyerler.")</p>
                </div>
            </a>
        </div>
    }

    @if (adminMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Departman" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">🏢 Departmanlar</h3>
                    <p class="text-secondary">Departman hiyerarşisini yönetin.</p>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="KullaniciYonetim" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">🧑‍💼 Kullanıcı Yönetimi</h3>
                    <p class="text-secondary">Amir/stajyer hesapları ve eşleştirme.</p>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Moderasyon" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">🛡️ Moderasyon</h3>
                    <p class="text-secondary">Bekleyen stajyer gönderilerini onaylayın/reddedin.</p>
                </div>
            </a>
        </div>
    }

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Profil" asp-action="Index" class="card card-link">
            <div class="card-body">
                <h3 class="card-title">🪪 Profilim</h3>
                <p class="text-secondary">Bilgilerinizi görüntüleyin ve düzenleyin.</p>
            </div>
        </a>
    </div>

    @if (adminMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="MisafirYonetim" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">🌐 TSE-Misafir Yönetimi</h3>
                    <p class="text-secondary">Talepler, manuel bağlama, ağ durumu ve giden e-postalar.</p>
                </div>
            </a>
        </div>
    }
    else if (amirMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="MisafirOnay" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">🌐 Misafir Onaylarım</h3>
                    <p class="text-secondary">Sponsor gösterildiğiniz misafir taleplerini onaylayın.</p>
                </div>
            </a>
        </div>
    }
    else if (stajyerMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Misafir" asp-action="Taleplerim" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">🌐 TSE-Misafir</h3>
                    <p class="text-secondary">Misafir ağı erişimi talep edin veya uzatın.</p>
                </div>
            </a>
        </div>
    }
    else
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">🌐 TSE-Misafir</h3>
                    <p class="text-secondary">Sponsor onay bağlantıları e-postanıza gelir.</p>
                </div>
            </div>
        </div>
    }

    @if (stajyerMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Proje" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">📋 Projem</h3>
                    <p class="text-secondary">Projenizi görüntüleyin ve ilerlemenizi güncelleyin.</p>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Odev" asp-action="Index" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">✅ Ödevlerim</h3>
                    <p class="text-secondary">Size atanan ödevleri görün ve durum bildirin.</p>
                </div>
            </a>
        </div>
    }
    else if (adminMi || amirMi)
    {
        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Odev" asp-action="Verdiklerim" class="card card-link">
                <div class="card-body">
                    <h3 class="card-title">📋 Proje &amp; Ödev</h3>
                    <p class="text-secondary">Stajyer detayından proje atayın, ödev verin ve takip edin.</p>
                </div>
            </a>
        </div>
    }
</div>
