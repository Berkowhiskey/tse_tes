@using TES.Infrastructure.Simulation
@model IReadOnlyList<GidenEposta>
@{
    ViewData["Title"] = "Giden E-postalar (Simülasyon)";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-pretitle">Simülasyon</div>
            <h2 class="page-title">Giden E-postalar</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn">← Misafir Yönetimi</a>
        </div>
    </div>
</div>

<div class="alert alert-info">
    Bu kutu, mock SMTP'nin teslimat kanalıdır — gerçekte e-postalar kurumun SMTP relay'i
    üzerinden gider ve sistemde saklanmaz. Sponsor onay bağlantılarını demoda buradan açabilirsiniz.
</div>

<div class="row row-cards">
    @foreach (var eposta in Model)
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h3 class="card-title mb-1">@eposta.Konu</h3>
                        <span class="text-secondary small">@eposta.Zaman.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <div class="text-secondary small mb-2">Kime: @eposta.Kime</div>
                    <pre class="mb-0" style="white-space: pre-wrap">@eposta.Icerik</pre>
                </div>
            </div>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="col-12 text-center text-secondary">Henüz e-posta gönderilmedi.</div>
    }
</div>
