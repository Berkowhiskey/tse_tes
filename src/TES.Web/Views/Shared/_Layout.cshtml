@using Microsoft.AspNetCore.Identity
@using TES.Domain.Sabitler
@using TES.Infrastructure.Identity
@inject UserManager<Kullanici> UserManager
@{
    var aktifKullanici = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;

    // Menü görünürlüğü yalnızca kolaylıktır; yetki her action'da sunucuda doğrulanır.
    var adminMi = User.IsInRole(Roller.Admin);
    var amirMi = User.IsInRole(Roller.Amir);
    var stajyerMi = User.IsInRole(Roller.Stajyer);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — TES</title>
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu"
                        aria-controls="navbar-menu" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        TSE · TES
                    </a>
                </h1>

                @if (aktifKullanici is not null)
                {
                    <div class="navbar-nav flex-row order-md-last">
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown"
                               aria-label="Kullanıcı menüsü" aria-expanded="false">
                                <span class="avatar avatar-sm">@aktifKullanici.AdSoyad.Substring(0, 1)</span>
                                <div class="d-none d-xl-block ps-2">
                                    <div>@aktifKullanici.AdSoyad</div>
                                    <div class="mt-1 small text-secondary">@string.Join(", ", await UserManager.GetRolesAsync(aktifKullanici))</div>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <a asp-controller="Profil" asp-action="Index" class="dropdown-item">Profilim</a>
                                <a asp-controller="Hesap" asp-action="ParolaDegistir" class="dropdown-item">Parola Değiştir</a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Hesap" asp-action="Cikis" method="post">
                                    <button type="submit" class="dropdown-item">Çıkış Yap</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="collapse navbar-collapse" id="navbar-menu">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <span class="nav-link-title">Ana Sayfa</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Gonderi" asp-action="Index">
                                    <span class="nav-link-title">Sosyal Akış</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Sohbet" asp-action="Index">
                                    <span class="nav-link-title">Sohbet</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Yoklama" asp-action="Index">
                                    <span class="nav-link-title">Yoklama</span>
                                </a>
                            </li>
                            @if (adminMi || amirMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Stajyerler" asp-action="Index">
                                        <span class="nav-link-title">Stajyerler</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Odev" asp-action="Verdiklerim">
                                        <span class="nav-link-title">Verdiğim Ödevler</span>
                                    </a>
                                </li>
                            }
                            @if (stajyerMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Proje" asp-action="Index">
                                        <span class="nav-link-title">Projem</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Odev" asp-action="Index">
                                        <span class="nav-link-title">Ödevlerim</span>
                                    </a>
                                </li>
                            }
                            @if (adminMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Departman" asp-action="Index">
                                        <span class="nav-link-title">Departmanlar</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="KullaniciYonetim" asp-action="Index">
                                        <span class="nav-link-title">Kullanıcı Yönetimi</span>
                                    </a>
                                </li>
                            }
                            @if (adminMi || stajyerMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="YoklamaSimulator" asp-action="Index">
                                        <span class="nav-link-title">RFID Simülatör</span>
                                    </a>
                                </li>
                            }
                            @if (stajyerMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Misafir" asp-action="Taleplerim">
                                        <span class="nav-link-title">TSE-Misafir</span>
                                    </a>
                                </li>
                            }
                            @if (amirMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="MisafirOnay" asp-action="Index">
                                        <span class="nav-link-title">Misafir Onaylarım</span>
                                    </a>
                                </li>
                            }
                            @if (adminMi)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="MisafirYonetim" asp-action="Index">
                                        <span class="nav-link-title">Misafir Yönetimi</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Moderasyon" asp-action="Index">
                                        <span class="nav-link-title">Moderasyon</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </header>

        <div class="page-wrapper">
            <div class="page-body">
                <div class="container-xl">
                    @if (TempData["Basari"] is string basariMesaji)
                    {
                        <div class="alert alert-success alert-dismissible" role="alert">
                            @basariMesaji
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
                        </div>
                    }
                    @if (TempData["Hata"] is string hataMesaji)
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            @hataMesaji
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></a>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl text-center text-secondary">
                    TSE — Takip ve Eğitim Sistemi (TES) · Staj Projesi
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/tabler/js/tabler.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
